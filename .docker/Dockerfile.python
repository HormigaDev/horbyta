FROM python:3.12-slim-bookworm AS builder

WORKDIR /build

RUN apt-get update && apt-get install -y \
    build-essential \
    protobuf-compiler \
    && rm -rf /var/lib/apt/lists/*

COPY horbyta_ai/requirements.txt .

RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip --no-cache-dir \
    && /opt/venv/bin/pip install --no-cache-dir -r requirements.txt


COPY proto/ /build/proto/
RUN mkdir -p /build/generated \
    && /opt/venv/bin/python -m grpc_tools.protoc \
    -I /build/proto \
    --python_out=/build/generated \
    --pyi_out=/build/generated \
    --grpc_python_out=/build/generated \
    /build/proto/horbyta_service.proto

FROM python:3.12-slim-bookworm AS runtime

RUN apt-get update && apt-get install -y \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN groupadd -r aigroup \
    && useradd -r -g aigroup -s /bin/false -d /app aiuser

WORKDIR /app

COPY --from=builder /opt/venv /opt/venv
COPY --from=builder /build/generated ./generated
COPY horbyta_ai/src/ ./src
COPY scripts/init-python.sh ./init.sh

RUN chmod +x ./init.sh \
    && chown -R aiuser:aigroup /app /opt/venv

ENV PATH="/opt/venv/bin:$PATH"
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONPATH="/app"

USER aiuser

HEALTHCHECK --interval=30s --timeout=10s --start-period=20s --retries=3 \
    CMD python -c "\
        import grpc, sys; \
        ch = grpc.insecure_channel('localhost:${GRPC_PORT:-50051}'); \
        f = grpc.channel_ready_future(ch); \
        f.result(timeout=5); \
        sys.exit(0)" || exit 1

ENTRYPOINT ["./init.sh"]