# ===== DATABASE CONFIGURATION =====
DATABASE_URL=postgresql://development:developer123@localhost:5434/hormigapm_development

# ===== APPLICATION SETTINGS =====
APP_URI=127.0.0.1:8890
APP_ENV=development
APP_VERSION=latest
BINARY_NAME=your_binary_name

# ===== JWT AUTHENTICATION =====
# Generate a secure random string of at least 32 characters for both secrets
JWT_SECRET=your-token-secret-of-32-minimum-characters
JWT_SECRET_CLIENT=your-token-secret-of-32-minimum-characters
TIME_TO_EXP_SESSION=7d

# ===== SERVER CONFIGURATION =====
RUST_PORT=8890
RUST_LOG=debug

# ===== GRPC SERVICE =====
GRPC_PORT=50051
AI_SERVICE_URL=http://horbyta_ai:50051

# ===== SESSION MANAGEMENT =====
SESSION_TTL_SECONDS=1800
EVICTION_INTERVAL_SECONDS=60

# ===== AI SERVICE SETTINGS =====
AI_LOG_LEVEL=INFO
TOOL_WAIT_TIMEOUT_SECONDS=30
AI_PREFS_ENCRYPTION_KEY=replace_with_base64_32_bytes_key

# ===== OPENROUTER API CONFIGURATION =====
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_SITE_URL=http://localhost:9000
OPENROUTER_APP_NAME=Horbyta
OPENROUTER_ENABLE_CACHE_CONTROL=true
OPENROUTER_CACHE_TTL=

# ===== S3 STORAGE CONFIGURATION =====
# Configure these variables if you need S3 support
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT=
UPLOAD_DIR=./data/storage

# Límite global de almacenamiento por usuario para adjuntos (en GB)
USER_STORAGE_LIMIT_GB=2