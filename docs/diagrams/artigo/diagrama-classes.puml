@startuml diagrama-classes
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #4B5563
skinparam ArrowThickness 1.1
skinparam packageStyle rectangle
skinparam nodesep 70
skinparam ranksep 90
' Visual sóbrio, adequado a um trabalho acadêmico (independe do tema padrão do PlantUML).
skinparam BackgroundColor white
skinparam ClassBackgroundColor white
skinparam ClassBorderColor #374151
skinparam ClassHeaderBackgroundColor #F3F4F6
skinparam EntityBackgroundColor white
skinparam EntityBorderColor #374151
skinparam UsecaseBackgroundColor white
skinparam UsecaseBorderColor #374151
skinparam ActorBackgroundColor white
skinparam ActorBorderColor #374151
skinparam PackageBorderColor #6B7280
skinparam RectangleBorderColor #374151
skinparam LegendBackgroundColor #F9FAFB
skinparam LegendBorderColor #9CA3AF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold

title Horbyta — Diagrama de Classes (escopo do artigo)
skinparam classAttributeIconSize 0
skinparam linetype ortho
hide empty methods

class SolicitacaoDeMudanca {
  - id: Uuid  «PK»
  - title: String
  - client_request_description: String
  - technical_assessment: String?
  - impact_hours: Decimal
  - impact_cost: Decimal
  - schedule_impact_days: i32
  - status: String
  - decline_reason: String?
  - version: i32
  --
  + submeter()
  + avaliar(horas, custo, dias)
  + aprovar()
  + rejeitar(motivo)
  + marcarComoImplementada()
}
class Cliente {
  - id: Uuid  «PK»
  - name: String
  - status: String
  - email: String?
  - phone: String?
  - company: String?
  --
  + acessarPortal(email, senha)
}
class Fatura {
  - id: Uuid  «PK»
  - amount: Decimal
  - currency_type: String
  - status: String
  - due_date: Date?
  --
  + alterarStatus(status)
}
class Marco {
  - id: Uuid  «PK»
  - name: String
  - status: String
  - due_date: DateTime?
  --
  + atualizar(dados)
}
class Notificacao {
  - id: Uuid  «PK»
  - title: String
  - body: String?
  - is_read: bool
  --
  + marcarComoLida()
}
class Pagamento {
  - id: Uuid  «PK»
  - amount: Decimal
  - transaction_type: String
  - payment_date: Date
  --
  + registrar(valor)
  + estornar(valor)
}
class Projeto {
  - id: Uuid  «PK»
  - name: String
  - description: String?
  - status: String
  - billable: bool
  --
  + alterarStatus(status)
  + configurarFaturamento(tipo, valor)
}
class Tarefa {
  - id: Uuid  «PK»
  - title: String
  - status: String
  - priority: i16
  - due_date: DateTime?
  --
  + mover(status)
}
class RegistroDeTempo {
  - id: Uuid  «PK»
  - start_time: DateTime?
  - end_time: DateTime?
  - duration_minutes: i32
  - billable: bool
  --
  + iniciarCronometro()
  + pararCronometro()
}
class Freelancer {
  - id: Uuid  «PK»
  - name: String
  - email: String
  - role: String
  - status: String
  --
  + autenticar(email, senha)
}
enum StatusDaSolicitacao {
  rascunho (draft)
  enviada (submitted)
  avaliada (assessed)
  aprovada (approved)
  rejeitada (declined)
  implementada (implemented)
  cancelada (cancelled)
}
SolicitacaoDeMudanca --> StatusDaSolicitacao : status

Cliente "1" -- "0..*" SolicitacaoDeMudanca : client_id
Projeto "1" -- "0..*" SolicitacaoDeMudanca : project_id
Tarefa "0..1" -- "0..*" SolicitacaoDeMudanca : task_id
Freelancer "1" -- "0..*" Cliente : user_id
Projeto "1" -- "0..*" Fatura : project_id
Projeto "1" -- "0..*" Marco : project_id
Freelancer "1" -- "0..*" Notificacao : user_id
Fatura "0..1" -- "0..*" Pagamento : invoice_id
Projeto "1" -- "0..*" Pagamento : project_id
Cliente "0..1" -- "0..*" Projeto : client_id
Freelancer "1" -- "0..*" Projeto : user_id
Marco "0..1" -- "0..*" Tarefa : milestone_id
Projeto "0..1" -- "0..*" Tarefa : project_id
Fatura "0..1" -- "0..*" RegistroDeTempo : invoice_id
Tarefa "1" -- "0..*" RegistroDeTempo : task_id

legend right
  Gerado de src/entities (SeaORM) por scripts/generate-diagrams.py. Tipo com ? = opcional.
  O vínculo user_id com o Freelancer existe em quase todas as classes; desenhado apenas
  em Cliente, Projeto e Notificacao para legibilidade.
endlegend
@enduml
