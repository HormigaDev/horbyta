@startuml diagrama-casos-de-uso
skinparam shadowing false
skinparam defaultFontName Arial
skinparam defaultFontSize 12
skinparam roundCorner 6
skinparam ArrowColor #4B5563
skinparam ArrowThickness 1.1
skinparam packageStyle rectangle
skinparam nodesep 70
skinparam ranksep 90
' Visual sóbrio, adequado a um trabalho acadêmico (independe do tema padrão do PlantUML).
skinparam BackgroundColor white
skinparam ClassBackgroundColor white
skinparam ClassBorderColor #374151
skinparam ClassHeaderBackgroundColor #F3F4F6
skinparam EntityBackgroundColor white
skinparam EntityBorderColor #374151
skinparam UsecaseBackgroundColor white
skinparam UsecaseBorderColor #374151
skinparam ActorBackgroundColor white
skinparam ActorBorderColor #374151
skinparam PackageBorderColor #6B7280
skinparam RectangleBorderColor #374151
skinparam LegendBackgroundColor #F9FAFB
skinparam LegendBorderColor #9CA3AF
skinparam TitleFontSize 16
skinparam TitleFontStyle bold

title Horbyta — Diagrama de Casos de Uso (escopo do artigo)
left to right direction

actor "Freelancer" as Freelancer
actor "Cliente" as Cliente

rectangle "Horbyta" {
  usecase "Autenticar-se" as UC_LOGIN
  usecase "Consultar notificações" as UC_NOTIFY
  package "Gestão de projetos" {
    usecase "Gerenciar clientes" as UC_CLIENTS
    usecase "Gerenciar projetos" as UC_PROJECTS
    usecase "Gerenciar tarefas" as UC_TASKS
    usecase "Gerenciar marcos" as UC_MILESTONES
  }
  package "Tempo e faturamento" {
    usecase "Registrar tempo" as UC_TIME
    usecase "Gerenciar faturamento" as UC_INVOICES
    usecase "Registrar pagamentos" as UC_PAYMENTS
  }
  package "Solicitações de mudança" {
    usecase "Registrar solicitação\nde mudança" as UC_CR_CREATE
    usecase "Avaliar solicitação\nde mudança" as UC_CR_ASSESS
    usecase "Estimar impacto\n(horas, custo e prazo)" as UC_CR_IMPACT
    usecase "Aprovar ou rejeitar\nsolicitação de mudança" as UC_CR_DECIDE
    usecase "Liberar mudança para\no desenvolvimento" as UC_CR_RELEASE
  }
  package "Portal do cliente" {
    usecase "Acompanhar projetos\ne marcos" as UC_FOLLOW
  }
}

Freelancer -- UC_LOGIN
Freelancer -- UC_CLIENTS
Freelancer -- UC_PROJECTS
Freelancer -- UC_TASKS
Freelancer -- UC_MILESTONES
Freelancer -- UC_TIME
Freelancer -- UC_INVOICES
Freelancer -- UC_PAYMENTS
Freelancer -- UC_CR_CREATE
Freelancer -- UC_CR_ASSESS
Freelancer -- UC_NOTIFY
UC_LOGIN -- Cliente
UC_FOLLOW -- Cliente
UC_CR_CREATE -- Cliente
UC_CR_DECIDE -- Cliente
UC_NOTIFY -- Cliente
UC_CR_ASSESS ..> UC_CR_IMPACT : <<include>>
UC_CR_RELEASE ..> UC_CR_DECIDE : <<extend>>
@enduml
