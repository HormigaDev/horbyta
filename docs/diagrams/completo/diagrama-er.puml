tags ||--o{ task_tags
projects |o--o{ attachments
tasks |o--o{ attachments
milestones |o--o{ attachments
projects ||--o{ change_requests
clients ||--o{ change_requests
tasks |o--o{ change_requests
users ||--o{ notifications
projects ||--o| scope_projects
clients ||--o{ scope_projects
scope_projects ||--o{ scope_revisions
tasks ||--o| scope_task_links
scope_projects ||--o{ scope_task_links
change_requests |o--o{ scope_task_links
scope_revisions |o--o{ scope_task_links
milestones |o--o{ change_requests
scope_revisions |o--o{ change_requests
change_requests ||--o{ scope_change_revisions
change_requests ||--o{ scope_events
scope_events ||--o| scope_delivery
change_requests ||--o| scope_effects
invoices |o--o| scope_effects
milestones |o--o{ scope_effects
clients ||--o{ scope_notices
attachments ||--o| scope_preserved_attachments
scope_project_events ||--o{ scope_project_event_attachments
projects ||--o{ scope_project_events
scope_revisions ||--o{ scope_project_events
tasks ||--o{ scope_task_requirements
scope_revisions ||--o{ scope_task_requirements
attachments ||--o{ scope_project_event_attachments
scope_events ||--o{ scope_change_event_attachments
attachments ||--o{ scope_change_event_attachments
projects ||--o{ project_messages
project_messages ||--o{ project_message_attachments
attachments ||--o{ project_message_attachments
projects ||--o{ project_conversation_reads
change_requests ||--o| conversation_change_sources
projects ||--o{ conversation_change_sources
scope_revisions |o--o{ scope_revisions
change_requests |o--o{ scope_revisions

legend right
  * obrigatório (NOT NULL)   <<PK>> chave primária   <<FK>> chave estrangeira   <<UQ>> única
  user_id (freelancer proprietário) existe em quase todas as tabelas; essas ligações a users
  são omitidas para legibilidade, exceto em clients, projects, notifications e client_auth.
  Gerado do catálogo do PostgreSQL por scripts/generate-diagrams.py
endlegend
@enduml
